# 统一换行符：内容文件在仓库内一律使用 LF，避免 Windows 下产生整文件 diff
* text=auto

*.md      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.yml     text eol=lf

# 二进制资源不做换行符转换
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.webp    binary
*.woff    binary
*.woff2   binary
*.pdf     binary